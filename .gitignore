# شاهر الثاني — .gitignore

# ⚠️ الملف ده أهم ملف في المشروع — لا ترفع .env أبدًا
.env
*.env.local
.env.*

# Python & Caching
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
env/
.venv/
ENV/

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs & Temp
*.log
logs/
*.tmp
tmp/
temp/

# ─── Workspace & Media Render Artifacts ───
workspace/downloads/
workspace/exports/
workspace/temp_render/
workspace/history.json
*.mp4
*.mp3
*.wav
*.ass
*.srt
