# ═══════════════════════════════════════════════════════
# شاهر الثاني — Environment Variables Template
# انسخ الملف ده لـ .env وحط فيه القيم الحقيقية
# ⚠️ متشيلش .env على GitHub أبدًا
# ═══════════════════════════════════════════════════════

# ─── Telegram ───────────────────────────────────────────
# اعمله من @BotFather على تليجرام
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Supabase ────────────────────────────────────────────
# من Settings > API في مشروع Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── AI Sources (Fallback Chain) ────────────────────────

# 1) Gemini Official (Primary) — من https://aistudio.google.com
# مفاتيح منفصلة لكل مكون (عشان لو مفتاح اتسرب تلغيه لوحده)
GEMINI_API_KEY_BRAIN=your_gemini_key_for_brain_here
GEMINI_API_KEY_TREND=your_gemini_key_for_trend_radar_here
GEMINI_API_KEY_BROWSER=your_gemini_key_for_browser_agent_here

# 2) SeekAI ⚠️ إلزامي من اليوم الأول — مش اختياري
# يُستخدم كـ fallback لـ chat + المصدر الوحيد لتوليد الصور
SEEKAI_API_KEY=your_seekai_api_key_here
SEEKAI_BASE_URL=https://seekai.cc/v1

# موديل الصور الافتراضي عبر SeekAI
# خيارات: flux | nano-banana | seedream
SEEKAI_IMAGE_MODEL=flux

# 3) Duck.ai (Third Fallback) — لا يحتاج API key، مجاني تلقائيًا

# ─── App Settings ────────────────────────────────────────
# الـ URL بتاع Railway بعد الـ deploy
# مثال: https://shaher-ii-production.up.railway.app
WEBHOOK_BASE_URL=https://your-service.up.railway.app

# اسمك في تليجرام (Telegram user_id الرقمي)
# احصل عليه من @userinfobot على تليجرام
AUTHORIZED_USER_ID=your_telegram_user_id_here

# كلمة سر لحماية endpoint الـ webhook setup (اختارها بنفسك)
SETUP_SECRET=choose-a-secret-word-here

# Default AI Models
GEMINI_MODEL=gemini-1.5-flash
SEEKAI_MODEL=gemini-1.5-flash

# Environment (development | production)
ENVIRONMENT=production
