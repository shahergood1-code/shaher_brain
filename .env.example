# ═══════════════════════════════════════════════════════
# شاهر الثاني — Environment Variables Template
# انسخ الملف ده لـ .env وحط فيه القيم الحقيقية
# ⚠️ متشيلش .env على GitHub أبدًا
# ═══════════════════════════════════════════════════════

# ─── 1. Telegram (Phase 1 Bot) ──────────────────────────
# اعمله من @BotFather على تليجرام
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# اسمك في تليجرام (Telegram user_id الرقمي من @userinfobot)
AUTHORIZED_USER_ID=your_telegram_user_id_here

# كلمة سر لحماية endpoint الـ webhook setup
SETUP_SECRET=choose-a-secret-word-here

# الـ URL بتاع Railway بعد الـ deploy
WEBHOOK_BASE_URL=https://your-service.up.railway.app

# ─── 2. Supabase (Unified Memory) ───────────────────────
# من Settings > API في مشروع Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── 3. Cloud AI Sources (Fallback Chain) ───────────────
# Gemini Official (Primary) — من https://aistudio.google.com
GEMINI_API_KEY_BRAIN=your_gemini_key_for_brain_here
GEMINI_API_KEY_TREND=your_gemini_key_for_trend_radar_here
GEMINI_API_KEY_BROWSER=your_gemini_key_for_browser_agent_here

# SeekAI — كـ fallback لـ chat + توليد الصور
SEEKAI_API_KEY=your_seekai_api_key_here
SEEKAI_BASE_URL=https://seekai.cc/v1
SEEKAI_IMAGE_MODEL=flux

GEMINI_MODEL=gemini-1.5-flash
SEEKAI_MODEL=gemini-1.5-flash
ENVIRONMENT=production

# ─── 4. Content Orchestrator (Phase 2 Local AI) ─────────
# العقل المحلي (Ollama) على كرت RTX 4070 Laptop (8GB VRAM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# متصفح Chrome Remote Debugging
CHROME_CDP_PORT=9222

# روابط المحادثات المثبتة (Pinned Gems) في جيمناي
GEMINI_PINNED_YOUTUBE=https://gemini.google.com/gem/YOUR_YOUTUBE_GEM_ID
GEMINI_PINNED_SHAHER=https://gemini.google.com/gem/YOUR_SHAHER_GEM_ID

# واجهة Flow للصور والفيديو
FLOW_URL=https://labs.google/flow

# إعدادات الصوت العربي (edge-tts)
DEFAULT_VOICE=ar-EG-ShakirNeural

# إعدادات الترجمة التلقائية (faster-whisper)
# اختر cpu لتوفير الـ 8GB VRAM بالكامل لـ Ollama، أو cuda
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# إعدادات المونتاج والتسريع العتادي بـ NVENC
NVENC_PRESET=p4
NVENC_CQ=20
